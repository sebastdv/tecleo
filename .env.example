# Copia este archivo a `.env` en la raíz de cada app que lo necesite
# (apps/server/.env y apps/web/.env.local). Ningún valor real va al repo.

# ── docker-compose ─────────────────────────────────────────────
# Puerto del host para Postgres (5432 suele estar ocupado por otros proyectos).
POSTGRES_PORT=5440

# ── apps/server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4100
# Orígenes permitidos por CORS y Socket.IO, separados por comas.
WEB_ORIGIN=http://localhost:3100
DATABASE_URL=postgresql://tecleo:tecleo@localhost:5440/tecleo
# Base de los tests de integración (se migra sola al correr los tests).
DATABASE_URL_TEST=postgresql://tecleo:tecleo@localhost:5440/tecleo_test
# Firma de los access tokens. En producción: `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Ruta de la cookie de refresh tal como la ve el navegador (la API va bajo /api en la web).
REFRESH_COOKIE_PATH=/api/auth
# Intentos de registro/login por minuto y por IP (el refresh admite el triple).
# En desarrollo y E2E conviene subirlos: todo el tráfico sale de localhost.
AUTH_RATE_LIMIT=10
# Peticiones por minuto y por IP en el resto de la API.
RATE_LIMIT=120
# Saltos de proxy de confianza (Next en local, balanceador en producción).
TRUST_PROXY=1

# ── apps/web ───────────────────────────────────────────────────
# URL del server a la que Next reenvía /api/* (solo lado servidor).
SERVER_URL=http://localhost:4100
