// Modelo de datos de Tecleo. Los ids son UUID v7 (ordenables por fecha de creación).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TextType {
  quote
  code
  /// Palabras generadas (práctica por tiempo o por cantidad); el contenido vive en Race.
  words
}

enum RaceMode {
  practice
  bots
  public
  private
  ghost
  daily
  targeted
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Siempre en minúsculas.
  email        String   @unique
  passwordHash String
  nickname     String
  /// Apodo en minúsculas: el apodo es único sin distinguir mayúsculas.
  nicknameKey  String   @unique
  /// Identificador de un avatar del set propio (ver `AVATARS` en @tecleo/shared).
  avatar       String?
  /// Código ISO 3166-1 alfa-2.
  country      String?  @db.Char(2)
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())

  settings UserSettings?
  sessions Session[]
  results  RaceResult[]
  keyStats KeyStat[]
}

model UserSettings {
  userId    String   @id @db.Uuid
  /// JSON validado con `userSettingsSchema` de @tecleo/shared.
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Sesión de refresh token. Se guarda solo el hash del token; cada refresh rota el token y
/// marca el anterior. Si llega un token ya rotado, se revoca toda la familia (posible robo).
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  rotatedAt  DateTime?
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Text {
  /// Mismo id que en @tecleo/content (p. ej. "es-1a2b3c" o "code-js-debounce").
  id             String   @id
  content        String
  language       String   @db.VarChar(2)
  type           TextType
  author         String?
  source         String?
  gutenbergId    Int?
  length         Int
  lengthCategory String?
  difficulty     Int
  active         Boolean  @default(true)
  likes          Int      @default(0)
  dislikes       Int      @default(0)
  createdAt      DateTime @default(now())

  races Race[]

  @@index([language, type, active])
}

model Race {
  id         String   @id @default(uuid(7)) @db.Uuid
  textId     String?
  /// Texto exacto que se escribió (normalizado); necesario para repeticiones y validación.
  content    String
  language   String   @db.VarChar(2)
  mode       RaceMode
  /// Opciones de la prueba (modo de práctica, límite de tiempo, bots, reglas…).
  config     Json
  /// Semilla de la carrera: con ella se regeneran exactamente los mismos bots.
  seed       Int?
  createdAt  DateTime @default(now())

  text    Text?        @relation(fields: [textId], references: [id])
  results RaceResult[]

  @@index([mode, createdAt])
}

model RaceResult {
  id            String   @id @default(uuid(7)) @db.Uuid
  raceId        String   @db.Uuid
  userId        String?  @db.Uuid
  botName       String?
  botLevel      String?
  position      Int?
  /// Métricas calculadas por el servidor reproduciendo las pulsaciones con el motor.
  wpm           Float
  rawWpm        Float
  accuracy      Float
  consistency   Float
  durationMs    Int
  completed     Boolean
  /// Pulsaciones comprimidas (gzip de `encodeKeystrokes`). Los bots no las guardan: se regeneran.
  keystrokes    Bytes?
  /// Copias para filtrar e indexar rankings e historial sin unir con Race.
  mode          RaceMode
  language      String   @db.VarChar(2)
  ignoreAccents Boolean  @default(false)
  /// Reproducido y verificado por el servidor.
  validated     Boolean  @default(false)
  /// Sospechoso para el antitrampa: se guarda pero no cuenta para rankings.
  flagged       Boolean  @default(false)
  flagReason    String?
  createdAt     DateTime @default(now())

  race Race  @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([mode, language, createdAt, wpm])
  @@index([raceId])
}

enum KeyStatKind {
  key
  bigram
}

/// Agregados por usuario para el mapa de teclas débiles y los pares de letras problemáticos.
model KeyStat {
  userId   String      @db.Uuid
  kind     KeyStatKind
  key      String
  attempts Int         @default(0)
  errors   Int         @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, key])
}
