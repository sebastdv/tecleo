{
  "name": "tecleo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "e2e": "pnpm --filter @tecleo/e2e e2e",
    "lighthouse": "pnpm --filter @tecleo/e2e lighthouse",
    "local": "pnpm install && node scripts/local-env.mjs && pnpm db:up && pnpm turbo run build --filter=@tecleo/content && pnpm --filter @tecleo/server db:deploy && pnpm --filter @tecleo/server db:seed && pnpm dev"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
