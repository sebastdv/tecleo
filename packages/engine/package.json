{
  "name": "@tecleo/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Motor de mecanografía, métricas y bots en TypeScript puro (sin UI ni Node)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tecleo/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
